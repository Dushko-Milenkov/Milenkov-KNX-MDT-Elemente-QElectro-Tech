<definition version="0.80" type="element" link_type="thumbnail" width="300" height="200" hotspot_x="150" hotspot_y="100">
  <names>
    <name lang="en">MDT JAL-0810M.02 - 2D front</name>
    <name lang="de">MDT JAL-0810M.02 - 2D Frontansicht</name>
  </names>
  <informations>Unofficial QElectroTech conversion of original MDT manufacturer CAD drawing MDT_CAD_JAL-0810M02.dxf. Manufacturer CAD geometry and logos retained. Original rights remain with MDT technologies GmbH. Colored front assembly thumbnail with reconstructed green terminals and screw heads. Not a wiring symbol. CAD overall envelope: 144 x 91 mm including latch. Scale 2 QET units/mm. Source: https://www.mdt.de/fileadmin/user_upload/user_upload/download/MDT_CAD_mdt_catalog.zip</informations>
  <elementInformations>
    <elementInformation name="manufacturer" show="1">MDT</elementInformation>
    <elementInformation name="designation" show="1">JAL-0810M.02</elementInformation>
    <elementInformation name="description" show="1">KNX JAL-0810M.02</elementInformation>
  </elementInformations>
